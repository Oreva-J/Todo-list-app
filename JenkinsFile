pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Hi'){
            steps{
                echo "HI Oreva Awusi"
            }
        }
        stage('Huraay'){
            steps{
                echo "Hurray Oreva Awusi"
            }
        }
        stage(Git){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/devops']], extensions: [], userRemoteConfigs: [[credentialsId: 'for-GitHub-Log-Dev', url: 'https://github.com/Oreva-J/Todo-list-app.git']])
                dir
            }
        }
    }
}
